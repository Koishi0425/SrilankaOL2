# 运行环境：本地开发使用 development；自动化测试使用 test；线上使用 production。
NODE_ENV=development
# 日志级别常用值：debug、info、warn、error。排查本地问题时可临时改为 debug。
LOG_LEVEL=info
# API 监听地址。本机开发可用 127.0.0.1；容器或需要局域网访问时使用 0.0.0.0。
HOST=0.0.0.0
# API 监听端口。若 Windows 报 EACCES，请换成一个可用高位端口，并同步修改 VITE_API_PROXY_TARGET。
PORT=3000

# PostgreSQL：postgresql://用户名:密码@主机:端口/数据库名
# 开发与测试必须使用不同数据库，例如 srilanka_dev 和 srilanka_test。
DATABASE_URL=postgresql://srilanka:srilanka@localhost:5432/srilanka_dev
# Redis：最后的 /0 是数据库编号；测试环境建议使用 /1，避免污染开发缓存。
REDIS_URL=redis://localhost:6379/0

# 允许访问 API 的 Web 源地址，只填写“协议 + 主机 + 端口”，末尾不要带路径或斜杠。
WEB_ORIGIN=http://localhost:5173

# 注册方式：invite 由主持人生成一次性邀请码；open 自由注册；closed 关闭注册。
# production 未设置时默认关闭，现有账号仍可登录。
REGISTRATION_MODE=invite

# S3 兼容对象存储配置。本地 Compose 使用 MinIO；9000 是 API 端口，9001 是管理后台端口。
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=srilanka-dev
OBJECT_STORAGE_ACCESS_KEY=srilanka
# 请在共享或生产环境中替换此示例密钥，且不要提交真实密钥。
OBJECT_STORAGE_SECRET_KEY=change-me

# 浏览器调用 API 的基础路径。推荐保留相对路径，以便登录 Cookie 通过 Vite 代理正常工作。
VITE_API_BASE_URL=/api/v1
# Vite 开发代理实际转发到的 API 地址；端口必须与上面的 PORT 一致。
VITE_API_PROXY_TARGET=http://localhost:3000

# 仅供 `pnpm.cmd --filter @srilanka/api seed:dev` 创建或更新本地开发账号。
# 密码至少 8 位；这些值不要用于生产环境，也不要在此文件中填写真实生产密码。
SEED_HOST_USERNAME=host
SEED_HOST_PASSWORD=replace-with-a-local-password
SEED_HOST_NAME=Local Host
# seed:dev 会在没有游戏时同时建立唯一的活动游戏；国家名称使用英文或中文逗号分隔。
SEED_GAME_NAME=Srilanka Campaign
SEED_COUNTRY_NAMES=Kandy,Jaffna,Colombo

# 服务器自动备份：启动时及每隔指定分钟保存一次，结算发布前另外保存恢复点。
# 需安装与数据库主版本一致的 pg_dump / pg_restore，且运行账号拥有创建恢复数据库的权限。
# 仅 BACKUP_ENABLED=true 时启用 API 自动备份；手动 db:backup 命令不受此开关影响。
BACKUP_ENABLED=false
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=48
# 默认目录为项目根目录 backups；建议正式运行时指定独立磁盘的绝对路径。
# BACKUP_DIRECTORY=/srv/srilanka-backups
# BACKUP_SOURCE_ROOT=/srv/srilanka-source
# POSTGRES_BIN_DIR=/usr/lib/postgresql/17/bin
# 通过 WSL 或容器运行客户端时填写 JSON 字符串数组，详见 infrastructure/database/README.md。
# POSTGRES_COMMAND_PREFIX_JSON=[]

# 可选模型辅助：只填写在私有 .env；不要使用 VITE_ 前缀或提交真实密钥。
# deepseek 使用 https://api.deepseek.com；glm 使用 https://open.bigmodel.cn/api/paas/v4。
# compatible 需显式设置 LLM_BASE_URL，基础地址不要包含 /chat/completions。
# 密钥或模型名称留空时关闭。配置后重启 API，再由主持人在“剧本与规则”开启本局辅助。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=https://api.deepseek.com
LLM_JSON_MODE=true
# DeepSeek / GLM 默认关闭额外推理；旧 GLM 不支持 thinking 时设 false。
# compatible 不发送供应商专有的 thinking 字段。
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_MS=60000
