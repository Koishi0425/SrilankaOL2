{$SITE_ADDRESS::80} {
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		# Cloudflare Tunnel connects from the private Compose network and sets
		# CF-Connecting-IP. Restore the visitor address as the single trusted
		# X-Forwarded-For value so API rate limits stay per player. Direct
		# public requests cannot match the private-range condition.
		@via-cloudflare {
			remote_ip private_ranges
			header CF-Connecting-IP *
		}
		reverse_proxy @via-cloudflare api:3000 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			transport http {
				read_timeout 150s
			}
		}
		reverse_proxy api:3000 {
			transport http {
				read_timeout 150s
			}
		}
	}

	root * /srv
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Internal health endpoint works in both HTTP and automatic HTTPS modes.
:8081 {
	respond /healthz "ok" 200
}
