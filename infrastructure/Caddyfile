{$SITE_ADDRESS::80} {
	encode zstd gzip
	header X-Content-Type-Options nosniff

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy api:3000 {
			transport http {
				read_timeout 150s
			}
		}
	}

	root * /srv
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Internal health endpoint works in both HTTP and automatic HTTPS modes.
:8081 {
	respond /healthz "ok" 200
}
