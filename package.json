{
  "name": "srilankaol",
  "version": "0.0.0",
  "private": true,
  "description": "A host-led asynchronous strategy game platform.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter ./packages/** build",
    "predev": "pnpm build:packages",
    "dev": "pnpm --parallel --filter @srilanka/api --filter @srilanka/web --filter @srilanka/worker dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pretest": "pnpm build:packages",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @srilanka/database migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
