{
  "name": "@srilanka/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./backup": {
      "types": "./src/backup.ts",
      "import": "./dist/backup.js"
    },
    "./postgres-tools": {
      "types": "./src/postgres-tools.ts",
      "import": "./dist/postgres-tools.js"
    },
    "./backup-manager": {
      "types": "./src/backup-manager.ts",
      "import": "./dist/backup-manager.js"
    }
  },
  "dependencies": {
    "@srilanka/config": "workspace:*",
    "pg": "^8.22.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx src/migrate.ts",
    "backup": "tsx src/backup-cli.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  }
}
