# Copy to .env.docker. Docker deployment does not read your local development .env.
# Generate a password with: openssl rand -hex 24
# Use only URL-safe letters, numbers, - or _ here (it is also used in DATABASE_URL).
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_USER=srilanka
POSTGRES_DB=srilanka

# Default deployment: Cloudflare Tunnel. Replace the public hostname and token.
# Only loopback ports are published; TLS is provided by Cloudflare.
APP_ENV=production
APP_ORIGIN=https://game.example.com
SITE_ADDRESS=:80
WEB_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Public HTTPS deployment: APP_ENV=production, APP_ORIGIN=https://your-domain,
# SITE_ADDRESS=your-domain, WEB_BIND=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443.
# Point the domain to this server and allow inbound TCP 80/443 first.

# Paste the token from Cloudflare Zero Trust. Point the published application
# at http://web:8082. cloudflared starts with the normal `up`, without profiles.
CLOUDFLARE_TUNNEL_TOKEN=
# For a local trial, use APP_ENV=development, APP_ORIGIN=http://localhost:8080
# and start with --scale cloudflared=0. Direct HTTPS also skips cloudflared.

# Bootstrap the first host with the interactive CLI described in README.
REGISTRATION_MODE=invite
LOG_LEVEL=info
IMAGE_TAG=local

BACKUP_ENABLED=true
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=48

# Optional; no model is used when key or model is empty.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
# Compatible APIs require this; leave it commented for provider defaults.
# LLM_BASE_URL=https://your-provider.example/v1
LLM_JSON_MODE=true
LLM_DISABLE_THINKING=true
LLM_TIMEOUT_MS=60000
